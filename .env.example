# Public runtime endpoint for validated lottery data.
# The API must implement GET /markets/:market/draws.
VITE_DATA_API_BASE_URL=https://api.example.com

# Direct read-only Supabase fallback. The anon key is safe for browser use only
# when Row Level Security is enabled and service-role keys remain server-side.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Keep false until admin actions are backed by server-side authentication.
VITE_ADMIN_CONSOLE_ENABLED=false
